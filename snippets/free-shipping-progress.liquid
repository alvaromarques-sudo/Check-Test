{% doc %}
  This is a progress bar that updates automatically, so you only need to add and customize it 
  all functionality works out of the box. If you prefer, you can disable the automatic updates and implement
  your own script to control when the progress bar updates.

  @param {number} min_value_to_reach - The minimum cart value required to unlock free shipping.
  @param {string} [success_message] - Optional message displayed when the goal is reached.
  @param {string} [message] - Message displayed before reaching the goal. You can use [remaining] to show how much is left to qualify for free shipping.
  @param {boolean} use_auto_update - Determines whether the component automatically updates when the cart changes (add, update, or remove items).
  @param {color} fill_color - Color

  @example
  {% render 'free-shipping-progress',
    min_value_to_reach: 12000,
    success_message: "Great! You’ve unlocked free shipping.",
    message: "Spend [remaining] more to get free shipping."
  %}
{% enddoc %}

{% assign min_value_to_reach = min_value_to_reach | default: 12000 %}
{% assign success_message = success_message | default: 'Great! You’ve unlocked free shipping.' %}
{% assign message = message | default: 'Spend [remaining] more to get free shipping.' %}
{% assign use_auto_update = use_auto_update | default: true %}

{% assign cart_current = cart.original_total_price %}
{% assign render_custom_message = '' %}
{% assign render_custom_message_sucess = '' %}
{% assign rest = min_value_to_reach | minus: cart_current %}
{% if cart_current < min_value_to_reach %}
  {% assign percentage = cart_current | times: 100.0 | divided_by: min_value_to_reach %}
  {% assign rest_percentage = percentage | append: '%' %}
{% else %}
  {% assign rest_percentage = '100%' %}
{% endif %}

<div class="progress__container">
  {% if cart_current > min_value_to_reach %}
    {% assign render_custom_message = 'hide-message' %}
  {% else %}
    {% assign render_custom_message_sucess = 'hide-message' %}
  {% endif %}

  {% if message contains '[remaining]' %}
    {% capture remaining %}
        <span class="remaining">
        {{ rest | money}}
        </span>
    {% endcapture %}

    {% assign message = message | replace: '[remaining]', remaining %}
  {% endif %}

  <span class="message message_sucess {{ render_custom_message_sucess }}">{{ success_message }}</span>
  <span class="message {{ render_custom_message }}">{{ message }}</span>
  <div class="progress__bar">
    <div class="progress__fill" style="--width: {{ rest_percentage }}"></div>
  </div>
</div>

<style>
  .hide-message {
    display: none;
  }
  .progress__container {
    text-align: center;
  }
  .message {
    font-size: 16px;
    color: #000;
    margin-bottom: 10px;
    font-weight: 600;
  }
  .progress__bar {
    width: 100%;
    height: 4px;
    background: gray;
  }
  .progress__fill {
    display: flex;
    height: 100%;
    width: var(--width);
    background-color: {{fill_color}};
    transition: width 0.3s ease-in-out;
  }
  .progress__fill:empty {
    display: flex;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    (function initUpdateCartListener() {
      async function getUpdatedCart() {
        const response = await fetch(window.Shopify.routes.root + 'cart.js', { credentials: 'same-origin' });
        return response.json();
      }

      function dispatchUpdateCart(detail) {
        window.dispatchEvent(new CustomEvent('shopify:update_cart', { detail }));
      }

      const originalFetch = window.fetch;

      window.fetch = async function (...args) {
        const [url] = args;
        const isCartMutation =
          typeof url === 'string' &&
          (url.includes('/cart/add') ||
            url.includes('/cart/update') ||
            url.includes('/cart/change') ||
            url.includes('/cart/clear'));

        const response = await originalFetch.apply(this, args);

        if (isCartMutation && response.ok) {
          try {
            const cartData = await getUpdatedCart();

            dispatchUpdateCart({
              source: 'fetch',
              url,
              cart: cartData,
            });
          } catch (error) {
            console.error('Error getting updated cart:', error);
          }
        }

        return response;
      };
    })();

    window.addEventListener('shopify:update_cart', (event) => {
      console.log('Cart updated:', event.detail.cart);
      const current_total = parseInt(event.detail.cart?.original_total_price) || 0;
      const min_value = parseInt('{{min_value_to_reach}}');

      const remaining = (min_value - current_total) / 100;
      const percentage = Math.min((current_total * 100.0) / min_value, 100);

      const progressBarFill = document.querySelector('.progress__fill');
      const remainingText = document.querySelector('.remaining');
      if (progressBarFill && remainingText) {
        progressBarFill.style.setProperty('--width', `${percentage}%`);
        remainingText.textContent = remaining.toLocaleString('pt-BR', {
          style: 'currency',
          currency: 'BRL',
        });
      }
    });
  });
</script>
