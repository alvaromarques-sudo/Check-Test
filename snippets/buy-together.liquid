{% assign custom_product = product.metafields.custom.buy_together_2.value %}

{% if custom_product != blank and custom_product.available %}
  <div class="buy_together__container">
    <span class="buy_together__title">{{ block.settings.title }}</span>

    {% render 'card-product',
      card_product: custom_product,
      media_aspect_ratio: 'adapt',
      show_secondary_image: true,
      extend_height: true,
      placeholder_image: placeholder_image,
      skip_styles: skip_card_product_styles
    %}
  </div>

  <product-form
    class="product-form"
    data-hide-errors="{{ gift_card_recipient_feature_active }}"
    data-section-id="{{ section.id }}"
  >
    <div class="product-form__error-message-wrapper" role="alert" hidden="">
      <span class="svg-wrapper">
        <svg class="icon icon-error" viewBox="0 0 13 13">
          <circle cx="6.5" cy="6.5" r="5.5" stroke="#fff" stroke-width="2"></circle><circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width=".7"></circle><path fill="#fff" d="m5.874 3.528.1 4.044h1.053l.1-4.044zm.627 6.133c.38 0 .68-.288.68-.656s-.3-.656-.68-.656-.681.288-.681.656.3.656.68.656"></path><path fill="#fff" stroke="#EB001B" stroke-width=".7" d="M5.874 3.178h-.359l.01.359.1 4.044.008.341h1.736l.008-.341.1-4.044.01-.359H5.873Zm.627 6.833c.56 0 1.03-.432 1.03-1.006s-.47-1.006-1.03-1.006-1.031.432-1.031 1.006.47 1.006 1.03 1.006Z"></path>
        </svg>
      </span>
      <span class="product-form__error-message"></span>
    </div>
    <form
      method="post"
      action="/cart/add"
      id="{{ section.id }}"
      accept-charset="UTF-8"
      class="form"
      enctype="multipart/form-data"
      novalidate="novalidate"
      data-type="add-to-cart-form"
    >
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="items[0][id]" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="items[0][quantity]" value="1">
      <input
        type="hidden"
        name="items[1][id]"
        value="{{ custom_product.selected_or_first_available_variant.id }}"
      >

      <input type="hidden" name="items[1][quantity]" value="1">

      <div class="product-form__buttons">
        <button
          id="ProductSubmitButton-template--21039063531675__main"
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--secondary"
        >
          <span>{{ block.settings.button_text }} </span>

          <div class="loading__spinner hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="spinner" viewBox="0 0 66 66">
              <circle stroke-width="6" cx="33" cy="33" r="30" fill="none" class="path"></circle>
            </svg>
          </div>
        </button>
      </div>

      <input type="hidden" name="product-id" value="8505879363739"
      ><input type="hidden" name="section-id" value="template--21039063531675__main">
    </form>
  </product-form>

{% elsif request.design_mode %}
  <strong>
    This “Buy Together” block is active, but no product is being displayed because the buy_together_2 metafield has not
    been filled for this product.

    To see content here, go to your Shopify admin, edit the product, and add a related product to the corresponding
    metafield.
  </strong>
{% endif %}

<style>
  .buy_together__container {
    margin: 0;
  }

  .buy_together__container .card__information {
    padding-bottom: 0;
  }

  .buy_together__title {
    text-align: center;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .buy_together__button {
    margin: 0;
    width: 100%;
  }
</style>
